DATABASE_URL=postgresql://user:password@host/database?sslmode=require
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# OAuth providers. Set both values for each provider you want to enable.
# Callback URLs: /api/auth/callback/google and /api/auth/callback/github
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Local development against a plain Postgres instead of Neon (see the README):
# start `pnpm run db:proxy`, then uncomment this and use
# ?sslmode=disable in DATABASE_URL above. Add WSPROXY_PG_PORT if your Postgres
# is not on 5432.
# NEON_WS_PROXY=127.0.0.1:5480

# --- Optional: every feature below stays off until you set it ---------------

# Who may use /moderation (docs/decisions/0021). Comma-separated; either list
# works, and with both empty nobody is a moderator, so the page answers with an
# honest refusal. Reporting and blocking need no configuration - they work for
# everyone.
# MODERATOR_EMAILS=you@example.com
# MODERATOR_USER_IDS=

# File attachments (docs/decisions/0018). Uploads land on local disk by default.
# For the Chatpack R2 bucket, use the S3-compatible settings below. Create an
# R2 API token with Object Read & Write access scoped to that bucket, then keep
# its credentials server-only in .env.local (never expose them to the browser).
# FILE_STORAGE_DIRECTORY=.chatpack-files
# S3_BUCKET=filepack
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://08f2c15dc62f9e37886809321bbaa5bc.r2.cloudflarestorage.com

# Multi-node realtime (docs/decisions/0012). One process needs no Redis; two or
# more do, or a message sent on server A never reaches a listener on server B.
# REDIS_URL=redis://127.0.0.1:6379
