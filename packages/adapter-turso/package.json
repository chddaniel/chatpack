{
  "name": "@chatpack/adapter-turso",
  "version": "0.0.0",
  "description": "Drizzle ORM Turso/libSQL storage adapter for Chatpack",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://github.com/chddaniel/chatpack#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/chddaniel/chatpack.git",
    "directory": "packages/adapter-turso"
  },
  "bugs": {
    "url": "https://github.com/chddaniel/chatpack/issues"
  },
  "keywords": [
    "chat",
    "chatpack",
    "storage-adapter",
    "turso",
    "libsql",
    "drizzle"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "prepack": "node -e \"require('fs').copyFileSync('../../llms.txt','llms.txt')\""
  },
  "dependencies": {
    "@chatpack/core": "workspace:^"
  },
  "peerDependencies": {
    "@libsql/client": ">=0.15.0 <1",
    "drizzle-orm": ">=0.40.0 <1"
  },
  "devDependencies": {
    "@libsql/client": "^0.15.15",
    "@types/node": "^26.1.1",
    "drizzle-orm": "^0.45.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
