{
  "name": "@chatpack/core",
  "version": "0.11.0",
  "description": "Open-source chat infrastructure for developers - the Chatpack core engine",
  "license": "MIT",
  "homepage": "https://github.com/chddaniel/chatpack#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/chddaniel/chatpack.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/chddaniel/chatpack/issues",
  "keywords": [
    "chat",
    "messaging",
    "chat-backend",
    "realtime",
    "chatpack"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./plugins": {
      "import": {
        "types": "./dist/plugins/index.d.ts",
        "default": "./dist/plugins/index.js"
      },
      "require": {
        "types": "./dist/plugins/index.d.cts",
        "default": "./dist/plugins/index.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "plugins": [
        "./dist/plugins/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "prepack": "node -e \"require('fs').copyFileSync('../../llms.txt','llms.txt')\""
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
