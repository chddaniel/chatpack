DATABASE_URL=postgresql://user:password@host/database?sslmode=require
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_GITHUB_ID=your-github-oauth-app-client-id
AUTH_GITHUB_SECRET=your-github-oauth-app-client-secret

# Local development against a plain Postgres instead of Neon (see the README):
# start `{{PACKAGE_MANAGER}} run db:proxy`, then uncomment this and use
# ?sslmode=disable in DATABASE_URL above. Add WSPROXY_PG_PORT if your Postgres
# is not on 5432.
# NEON_WS_PROXY=127.0.0.1:5480
