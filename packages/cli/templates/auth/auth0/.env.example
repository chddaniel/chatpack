DATABASE_URL=postgresql://user:password@host/database?sslmode=require
AUTH0_DOMAIN=https://your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
AUTH0_SECRET=replace-with-at-least-32-random-characters
APP_BASE_URL=http://localhost:3000

# Local development against a plain Postgres instead of Neon (see the README):
# start `{{PACKAGE_MANAGER}} run db:proxy`, then uncomment this and use
# ?sslmode=disable in DATABASE_URL above. Add WSPROXY_PG_PORT if your Postgres
# is not on 5432.
# NEON_WS_PROXY=127.0.0.1:5480
