{
  "name": "{{PACKAGE_NAME}}",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "chatpackStarter": {
    "framework": "next",
    "authProvider": "better-auth"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate && tsx scripts/filepack-migrate.ts",
    "db:filepack": "tsx scripts/filepack-migrate.ts",
    "db:proxy": "tsx scripts/wsproxy.ts",
    "setup:check": "tsx scripts/setup-check.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1097.0",
    "@chatpack/adapter-drizzle": "{{CHATPACK_ADAPTER_DRIZZLE_VERSION}}",
    "@chatpack/client": "{{CHATPACK_CLIENT_VERSION}}",
    "@chatpack/core": "{{CHATPACK_CORE_VERSION}}",
    "@chatpack/file": "{{CHATPACK_FILE_VERSION}}",
    "@chatpack/transport-redis": "{{CHATPACK_TRANSPORT_REDIS_VERSION}}",
    "@filepack/adapter-drizzle": "0.1.1",
    "@filepack/client": "0.1.1",
    "@filepack/core": "0.1.1",
    "@filepack/storage-local": "0.1.1",
    "@filepack/storage-s3": "0.1.1",
    "@neondatabase/serverless": "1.1.0",
    "@vercel/functions": "3.9.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "drizzle-orm": "0.45.2",
    "ioredis": "5.11.1",
    "lucide-react": "1.31.0",
    "next": "16.2.6",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "ws": "8.21.3",
    "better-auth": "1.6.27"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/ws": "8.18.1",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.6",
    "shadcn": "4.17.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
