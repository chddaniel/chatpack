DATABASE_URL=postgresql://user:password@host/database?sslmode=require
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Local development against a plain Postgres instead of Neon (see the README):
# start `{{PACKAGE_MANAGER}} run db:proxy`, then uncomment this and use
# ?sslmode=disable in DATABASE_URL above. Add WSPROXY_PG_PORT if your Postgres
# is not on 5432.
# NEON_WS_PROXY=127.0.0.1:5480

# --- Optional: every feature below stays off until you set it ---------------

# Who may use /moderation (docs/decisions/0021). Comma-separated; either list
# works, and with both empty nobody is a moderator, so the page answers with an
# honest refusal. Reporting and blocking need no configuration - they work for
# everyone.
# MODERATOR_EMAILS=you@example.com
# MODERATOR_USER_IDS=

# File attachments (docs/decisions/0018). Uploads land on local disk by default;
# set S3_BUCKET to store them in any S3-compatible bucket instead, at which
# point the other S3_* values become required. S3_ENDPOINT is only needed for
# non-AWS providers such as R2, B2 or MinIO.
# FILE_STORAGE_DIRECTORY=.chatpack-files
# S3_BUCKET=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=

# Multi-node realtime (docs/decisions/0012). One process needs no Redis; two or
# more do, or a message sent on server A never reaches a listener on server B.
# REDIS_URL=redis://127.0.0.1:6379
