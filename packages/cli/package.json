{
  "name": "@chatpack/cli",
  "version": "0.1.0",
  "description": "CLI for initializing Chatpack in existing applications",
  "license": "MIT",
  "homepage": "https://github.com/chddaniel/chatpack#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/chddaniel/chatpack.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/chddaniel/chatpack/issues"
  },
  "keywords": [
    "chat",
    "chatpack",
    "cli",
    "scaffold",
    "setup"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "chatpack": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSE.typescript",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "prepack": "node -e \"require('fs').copyFileSync('../../llms.txt','llms.txt')\""
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
