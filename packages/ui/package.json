{
  "name": "@chatpack/ui",
  "version": "0.1.0",
  "description": "Reusable React UI blocks for Chatpack",
  "license": "MIT",
  "author": "Yeabsra Habtu <yeabsra.h@shipper.now> (https://github.com/Yeabsra-Habtu)",
  "contributors": [
    "DanielCH <hello@chdaniel.com> (https://github.com/chddaniel)",
    "Ikem Peter <ikem.peter@shipper.now> (https://github.com/ikemHood)",
    "DavidCH <chhddavid@gmail.com> (https://github.com/chhddavid)"
  ],
  "homepage": "https://docs.chatpack.dev/docs/blocks",
  "repository": {
    "type": "git",
    "url": "https://github.com/chddaniel/chatpack.git",
    "directory": "packages/ui"
  },
  "bugs": "https://github.com/chddaniel/chatpack/issues",
  "keywords": [
    "chat",
    "chatpack",
    "react",
    "ui",
    "components"
  ],
  "sideEffects": [
    "./styles.css"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "styles.css",
    "README.md",
    "CHANGELOG.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "prepack": "node -e \"require('fs').copyFileSync('../../llms.txt','llms.txt')\""
  },
  "dependencies": {
    "@chatpack/client": "workspace:^",
    "@chatpack/file": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.2.13",
    "react": "^19.2.8",
    "react-test-renderer": "^19.2.8",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
