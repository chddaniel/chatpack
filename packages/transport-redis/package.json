{
  "name": "@chatpack/transport-redis",
  "version": "0.1.9",
  "description": "Redis pub/sub transport for Chatpack - multi-node SSE fan-out",
  "license": "MIT",
  "author": "Yeabsra Habtu <yeabsra.h@shipper.now> (https://github.com/Yeabsra-Habtu)",
  "contributors": [
    "DanielCH <hello@chdaniel.com> (https://github.com/chddaniel)",
    "Ikem Peter <ikem.peter@shipper.now> (https://github.com/ikemHood)",
    "DavidCH <chhddavid@gmail.com> (https://github.com/chhddavid)"
  ],
  "homepage": "https://github.com/chddaniel/chatpack#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/chddaniel/chatpack.git",
    "directory": "packages/transport-redis"
  },
  "bugs": "https://github.com/chddaniel/chatpack/issues",
  "keywords": [
    "chat",
    "chatpack",
    "transport",
    "redis",
    "pubsub",
    "sse"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "prepack": "node -e \"require('fs').copyFileSync('../../llms.txt','llms.txt')\""
  },
  "dependencies": {
    "@chatpack/core": "workspace:^"
  },
  "devDependencies": {
    "@chatpack/adapter-memory": "workspace:^",
    "@types/node": "^26.1.1",
    "ioredis": "^5.11.1",
    "redis": "^5.12.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
