    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chatpack/adapter-memory": "workspace:*",
    "@chatpack/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.3.1",
    "typescript": "^5.7.2"
  }
}
